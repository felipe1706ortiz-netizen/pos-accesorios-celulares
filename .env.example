# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA POS & ACCESORIOS
# ==============================================================================

# Entorno de la aplicación: 'development' o 'production'
APP_ENV=development
APP_TIMEZONE=America/Bogota

# ==============================================================================
# OPCIÓN A: CONEXIÓN LOCAL (MySQL / XAMPP)
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_accesorios
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ==============================================================================
# OPCIÓN B: CONEXIÓN EN LA NUBE CON SUPABASE (PostgreSQL)
# ==============================================================================
# DB_DRIVER=pgsql
# DB_HOST=aws-0-us-west-2.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.tu-proyecto-ref
# DB_PASS=tu-password-de-supabase
# DB_SSLMODE=require

# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP / PHPMAILER)
# ==============================================================================
# Para Gmail: usar una "Contraseña de aplicación" generada en tu cuenta de Google
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicacion
# SMTP_SECURE=tls
# MAIL_FROM_ADDRESS=tu-correo@gmail.com
# MAIL_FROM_NAME="POS Celulares & Accesorios"
