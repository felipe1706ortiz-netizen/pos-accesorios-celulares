# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA POS & ACCESORIOS
# ==============================================================================

# Entorno de la aplicación: 'development' o 'production'
APP_ENV=development
APP_TIMEZONE=America/Bogota

# ==============================================================================
# OPCIÓN A: CONEXIÓN LOCAL (MySQL / XAMPP)
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pos_accesorios
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ==============================================================================
# OPCIÓN B: CONEXIÓN EN LA NUBE CON SUPABASE (PostgreSQL)
# ==============================================================================
# Puedes usar los parámetros individuales o la URL de conexión directa:
#
# DB_DRIVER=pgsql
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.tu-proyecto-ref
# DB_PASS=tu-password-de-supabase
# DB_SSLMODE=require
#
# O bien mediante una sola variable:
# DATABASE_URL=postgresql://postgres.tu-proyecto-ref:tu-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
