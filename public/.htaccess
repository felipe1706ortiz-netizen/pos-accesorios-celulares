<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirigir peticiones con prefijo /public/ redundante hacia la raíz
    RewriteRule ^public/(.*)$ $1 [L,QSA]

    # Si el archivo o directorio solicitado existe físicamente, servirlo directamente (css, js, imágenes)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # De lo contrario, redirigir todo al Front Controller
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Proteger listado de directorios
Options -Indexes
